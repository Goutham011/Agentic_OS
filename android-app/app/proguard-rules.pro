# Agentic OS ProGuard Rules

# ===== KEEP HILT GENERATED CLASSES =====
-keep class dagger.hilt.** { *; }
-keep class * extends dagger.hilt.android.HiltAndroidApp { *; }
-keep class * extends dagger.hilt.android.HiltApplication { *; }
-keep class * extends dagger.hilt.android.HiltComponent { *; }
-keep class * extends dagger.hilt.android.HiltViewModel { *; }

# ===== KEEP ROOM ENTITIES AND DAOs =====
-keep class com.agenticos.agent.models.** { *; }
-keep class com.agenticos.agent.data.** { *; }

# ===== KEEP KOTLINX SERIALIZATION (FIX #16) =====
# Keep all serializer classes generated by kotlinx.serialization
-keep class kotlinx.serialization.** { *; }
-keep class kotlinx.serialization.descriptors.** { *; }
-keep class kotlinx.serialization.encoding.** { *; }
-keep class kotlinx.serialization.json.** { *; }
-keepclassmembers class ** {
    @kotlinx.serialization.* *;
}
-keepclassmembers class * {
    @kotlinx.serialization.SerialName * <fields>;
}

# Keep generated serializers
-keep class *$$Serializer { *; }
-keep class *$$SerializableKt { *; }
-keepclassmembers class ** {
    @kotlinx.serialization.Serializable <methods>;
}

# Keep companion object serializers
-keepclassmembers class com.agenticos.agent.models.** {
    public static <fields>;
}

# ===== KEEP MEDIAPIPE LLM CLASSES =====
-keep class com.google.mediapipe.tasks.genai.** { *; }

# ===== KEEP ML KIT TEXT RECOGNITION =====
-keep class com.google.mlkit.text.** { *; }

# ===== KEEP PORCUPINE WAKE WORD =====
-keep class ai.picovoice.porcupine.** { *; }
-keep class ai.picovoice.** { *; }

# ===== KEEP JSOUP =====
-keep class org.jsoup.** { *; }

# ===== KEEP RETROFIT/OKHTTP =====
-keep class retrofit2.** { *; }
-keep class okhttp3.** { *; }
-keep class okio.** { *; }

# ===== KEEP COROUTINES =====
-keep class kotlinx.coroutines.** { *; }

# ===== KEEP WORKMANAGER =====
-keep class androidx.work.** { *; }

# ===== KEEP HILT/ASSISTED INJECT =====
-keep class javax.inject.** { *; }
-keep class dagger.** { *; }

# ===== KEEP ANDROIDX =====
-keep class androidx.** { *; }

# ===== KEEP SERVICE CLASSES =====
-keep class com.agenticos.agent.service.** { *; }
-keep class com.agenticos.agent.accessibility.** { *; }
-keep class com.agenticos.agent.automation.** { *; }
-keep class com.agenticos.agent.tools.** { *; }
-keep class com.agenticos.agent.llm.** { *; }
-keep class com.agenticos.agent.voice.** { *; }

# ===== KEEP ACTIVITY AND APPLICATION CLASSES =====
-keep class com.agenticos.agent.MainActivity { *; }
-keep class com.agenticos.agent.BootReceiver { *; }
-keep class com.agenticos.agent.AgenticOSApplication { *; }

# ===== KEEP PARCELABLE/SERIALIZABLE =====
-keepclassmembers class * implements android.os.Parcelable {
    static ** CREATOR;
}
-keepclassmembers class com.agenticos.agent.models.** {
    serialVersionUID = 1L;
    private static final java.io.ObjectStreamField[] serialPersistentFields;
    !static !transient <fields>;
    !private <methods>;
}
-keepclassmembers class com.agenticos.agent.utils.** {
    serialVersionUID = 1L;
    private static final java.io.ObjectStreamField[] serialPersistentFields;
    !static !transient <fields>;
    !private <methods>;
}

# ===== KEEP ENUMS FOR SERIALIZATION =====
-keepclassmembers enum com.agenticos.agent.models.** {
    public static **[] values();
    public static ** valueOf(java.lang.String);
}

# ===== KEEP DATA CLASSES =====
-keep class com.agenticos.agent.models.* {
    <fields>;
    <init>(...);
}

# ===== DON'T WARN ABOUT MISSING CLASSES =====
-dontwarn org.jsoup.**
-dontwarn com.google.mediapipe.**
-dontwarn ai.picovoice.**
-dontwarn kotlinx.serialization.**
-dontwarn retrofit2.**
-dontwarn okhttp3.**
-dontwarn okio.**
-dontwarn kotlinx.coroutines.**
-dontwarn androidx.work.**
-dontwarn com.google.mlkit.**

# ===== OPTIMIZATION FLAGS =====
# Enable aggressive optimization while preserving reflection
-optimizationpasses 5
-allowaccessmodification
-optimizations !code/simplification/arithmetic,!field/*,!class/merging/*

# ===== KEEP DEBUG INFO FOR DEBUG BUILD =====
-keep class **$ProtoBufTreeEncoder { *; }
-keep class **$ProtoBufTreeDecoder { *; }